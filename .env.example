# ─── Banco de dados (PostgREST + postgres.js) ───────────────────────────────
# URL direta ao PostgreSQL (postgres.js — Server Actions, auth, audit)
DATABASE_URL=postgresql://erp_admin:SENHA@localhost:5432/erp_alma

# PostgREST exposto localmente na porta 3001 — aponta como se fosse o Supabase
NEXT_PUBLIC_SUPABASE_URL=http://localhost:3001

# Chave anon JWT para PostgREST (gerada com JWT_SECRET, role=anon)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave service_role JWT para PostgREST (bypassa RLS — só server-side)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Auth / Sessão ───────────────────────────────────────────────────────────
# Segredo para assinar JWTs de sessão — string aleatória longa
JWT_SECRET=

# Marca os cookies de sessão como `secure` (só trafegam via HTTPS).
# Deixe vazio/false enquanto a app rodar em HTTP puro (senão o navegador
# descarta o cookie e o login entra em loop de redirect). Defina como `true`
# somente depois de servir o app por HTTPS.
COOKIE_SECURE=false

# ─── Storage ────────────────────────────────────────────────────────────────
# Diretório base onde as imagens são salvas (produção)
UPLOADS_DIR=/var/www/erp-uploads

# URL pública do app (usada para montar URLs das imagens)
NEXT_PUBLIC_BASE_URL=http://69.62.103.155
